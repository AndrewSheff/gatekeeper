<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Permissions -->
    <changeSet id="002-1" author="ashevtsov">
        <createTable tableName="permissions">
            <column name="id" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="resource" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)"/>
        </createTable>

        <addUniqueConstraint tableName="permissions" columnNames="resource,action"
                             constraintName="uq_permissions_resource_action"/>
    </changeSet>

    <!-- Roles -->
    <changeSet id="002-2" author="ashevtsov">
        <createTable tableName="roles">
            <column name="id" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(500)"/>
            <column name="parent_id" type="uuid">
                <constraints foreignKeyName="fk_roles_parent" references="roles(id)"/>
            </column>
            <column name="tenant_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_roles_tenant" references="tenants(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="roles" columnNames="name,tenant_id"
                             constraintName="uq_roles_name_tenant"/>
        <createIndex tableName="roles" indexName="idx_roles_tenant">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <!-- Role-Permissions -->
    <changeSet id="002-3" author="ashevtsov">
        <createTable tableName="role_permissions">
            <column name="role_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_rp_role" references="roles(id)"/>
            </column>
            <column name="permission_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_rp_permission" references="permissions(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="role_permissions" columnNames="role_id,permission_id"/>
    </changeSet>

    <!-- Users -->
    <changeSet id="002-4" author="ashevtsov">
        <createTable tableName="users">
            <column name="id" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="username" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="varchar(100)"/>
            <column name="last_name" type="varchar(100)"/>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_users_tenant" references="tenants(id)"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="users" columnNames="username,tenant_id"
                             constraintName="uq_users_username_tenant"/>
        <addUniqueConstraint tableName="users" columnNames="email,tenant_id"
                             constraintName="uq_users_email_tenant"/>
        <createIndex tableName="users" indexName="idx_users_tenant">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="users" indexName="idx_users_email">
            <column name="email"/>
        </createIndex>
    </changeSet>

    <!-- User-Roles -->
    <changeSet id="002-5" author="ashevtsov">
        <createTable tableName="user_roles">
            <column name="user_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_ur_user" references="users(id)"/>
            </column>
            <column name="role_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_ur_role" references="roles(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_roles" columnNames="user_id,role_id"/>
    </changeSet>

</databaseChangeLog>
