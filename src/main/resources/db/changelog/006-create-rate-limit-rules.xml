<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="006-1" author="ashevtsov">
        <createTable tableName="rate_limit_rules">
            <column name="id" type="uuid">
                <constraints primaryKey="true"/>
            </column>
            <column name="tenant_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_rate_rules_tenant" references="tenants(id)"/>
            </column>
            <column name="route_id" type="uuid">
                <constraints foreignKeyName="fk_rate_rules_route" references="gateway_routes(id)"/>
            </column>
            <column name="requests_per_second" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="burst_capacity" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
